# ============================================================================
# SOUND LOUNGE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local (frontend) and .env (backend)
# Update values for your environment

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Supabase
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_OFFLINE_MODE=false
VITE_LOG_LEVEL=debug

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/soundlounge
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# Supabase (if using as backend)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_at_least_32_chars
JWT_EXPIRY=7d
SESSION_SECRET=your_session_secret_change_in_production_at_least_32_chars
COOKIE_SECURE=false # Set to true in production with HTTPS

# Storage (for audio files)
SUPABASE_STORAGE_BUCKET=soundlounge-audio

# S3-compatible storage (alternative to Supabase)
S3_REGION=us-east-1
S3_BUCKET=soundlounge-audio
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_ENDPOINT=https://s3.amazonaws.com # or custom S3-compatible endpoint

# Audio Configuration
AUDIO_MAX_FILE_SIZE=104857600 # 100MB in bytes
AUDIO_ALLOWED_FORMATS=mp3,wav,flac,aac,ogg
AUDIO_BITRATE_STREAMING=128k # For transcoding if needed

# Third-party Services

# Stripe (if implementing premium)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SendGrid, Mailgun, etc.)
EMAIL_PROVIDER=sendgrid # or 'mailgun', 'smtp'
EMAIL_API_KEY=sg_xxx
EMAIL_FROM=noreply@soundlounge.app

# Analytics
ANALYTICS_PROVIDER=custom # or 'posthog', 'mixpanel', 'segment'
ANALYTICS_API_KEY=xxx
ANALYTICS_ENABLED=true

# Logging
LOG_LEVEL=info # debug, info, warn, error
LOG_FORMAT=json # json or text
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# Server Configuration
NODE_ENV=development # development, test, production
PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100 # requests per window
RATE_LIMIT_ENABLED=true

# Recommendation Engine
RECOMMENDATION_CACHE_TTL=300 # seconds
RECOMMENDATION_COLD_START_LIMIT=5 # interactions before personalization
RECOMMENDATION_BATCH_SIZE=50
RECOMMENDATION_DIVERSITY_ENABLED=true

# Search Configuration
SEARCH_INDEX_UPDATE_INTERVAL=3600 # seconds (1 hour)
SEARCH_RESULT_LIMIT=50
SEARCH_FUZZY_ENABLED=true
SEARCH_SUGGESTION_COUNT=5

# Feature Configuration
MAX_PLAYLIST_SIZE=500
MAX_PLAYLISTS_PER_USER=100
MAX_RECENT_TRACKS=100
MAX_HIDDEN_TRACKS=500
CACHE_TRACK_METADATA=true
CACHE_TTL_MINUTES=60

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Testing
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/soundlounge_test
TEST_SEED_DATA=true

# Development Helpers
MOCK_AUDIO_ENABLED=false # Use mock audio in development
MOCK_AUTH_ENABLED=false # Auto-login without password
DEV_SKIP_EMAIL_VERIFICATION=false
DEV_LOG_QUERIES=false # Log all database queries

# ============================================================================
# PRODUCTION SECURITY
# ============================================================================
# These should NEVER be in version control when set to production values

# HTTPS Enforcement
FORCE_HTTPS=true # Set to true in production
HSTS_MAX_AGE=31536000 # 1 year

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# API Security
API_KEY_REQUIRED=false # Require API key for public endpoints
API_KEY=your_api_key_here

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================

# Message Queue (for async tasks)
QUEUE_PROVIDER=memory # memory, redis, Bull
REDIS_URL=redis://localhost:6379

# Recommendation ML Service (if available)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=false
ML_SERVICE_TIMEOUT=30000

# Monitoring / APM
APM_ENABLED=false
APM_SERVICE=datadog # datadog, newrelic, etc.
APM_SERVICE_KEY=xxx

# Feature Flags
FEATURE_FLAGS_ENABLED=true
FEATURE_FLAGS_PROVIDER=custom # custom, launchdarkly, etc.

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. NEVER commit actual secret values to git
# 2. Use .env.local for local development (git-ignored)
# 3. Use .env.production for production secrets (stored securely)
# 4. Rotate keys regularly in production
# 5. Each environment should have distinct credentials
# 6. Keep LOG_LEVEL='debug' only in development
#
# ============================================================================
